{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "tap-tap",

      "//": "초안으로 만든다. 설치 파일이 다 올라간 뒤에 워크플로가 공개로 바꾼다 — 반쪽짜리 릴리스가 최신 버전으로 잡히면 랜딩페이지와 자동 업데이트가 헛걸음한다.",
      "draft": true,

      "//changelog": "받는 사람이 읽을 목록이다. 내부 정리(chore·ci·refactor·test)는 굳이 보여주지 않는다.",
      "changelog-sections": [
        { "type": "feat", "section": "새로운 것" },
        { "type": "fix", "section": "고친 것" },
        { "type": "perf", "section": "빨라진 것" },
        { "type": "docs", "section": "문서", "hidden": true },
        { "type": "chore", "section": "정리", "hidden": true },
        { "type": "ci", "section": "빌드", "hidden": true },
        { "type": "refactor", "section": "구조", "hidden": true },
        { "type": "test", "section": "검사", "hidden": true }
      ]
    }
  }
}
