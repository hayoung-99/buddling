{
  "name": "tap-tap",
  "version": "0.1.0",
  "private": true,
  "description": "바탕화면 위 3D 동물 친구. 내 캐릭터를 클릭하면 팀원들의 캐릭터가 폴짝 뜁니다.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayoung-99/tap-tap.git"
  },
  "homepage": "https://tap-tap-desktop.vercel.app",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "start:second": "TAPTAP_PROFILE=second electron .",
    "start:both": "trap 'kill 0' INT TERM EXIT; npm start & npm run start:second & wait",
    "preview": "electron scripts/preview.js",
    "tray-icon": "node scripts/make-tray-icon.js",
    "app-icon": "electron scripts/make-app-icon.js",
    "site-images": "electron scripts/make-site-images.js",
    "site": "node scripts/serve-site.js",
    "site:open": "node scripts/serve-site.js --open",
    "dist": "node scripts/bake-config.js && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:site": "node scripts/check-site.js",
    "check": "node scripts/e2e-check.js",
    "check:expiry": "node scripts/check-expiry.js"
  },
  "build": {
    "appId": "com.taptap.desktop",
    "productName": "tap-tap",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/renderer/preview/**",
      "!src/renderer/icon/**",
      "!src/renderer/site-assets/**",
      "assets/**/*",
      "node_modules/three/build/three.module.js",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "hayoung-99",
        "repo": "tap-tap",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build/icon.icns",
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "three": "^0.169.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vitest": "^4.1.10"
  }
}
