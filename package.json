{
  "name": "buddling-workspace",
  "private": true,
  "description": "Buddling 저장소. 실제 앱은 apps/ 아래에 있다.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayoung-99/buddling.git"
  },
  "homepage": "https://buddling.vercel.app",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w buddling && npm run build -w @buddling/web",
    "build:web": "npm run build -w @buddling/web",
    "test": "npm run test -w buddling",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "app-icon": "npm run app-icon -w buddling",
    "check": "npm run check -w buddling",
    "check:expiry": "npm run check:expiry -w buddling",
    "check:site": "npm run build:web && node scripts/check-site.js",
    "dev": "npm run dev -w buddling",
    "dev:web": "npm run dev -w @buddling/web",
    "dist": "npm run dist -w buddling",
    "preview": "npm run preview -w buddling",
    "site-images": "npm run site-images -w buddling --",
    "start": "npm run start -w buddling",
    "tray-icon": "npm run tray-icon -w buddling"
  },
  "devDependencies": {
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
