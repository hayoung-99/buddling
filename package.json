{
  "name": "tap-tap",
  "version": "0.4.0",
  "private": true,
  "description": "바탕화면 위 3D 동물 친구. 내 캐릭터를 클릭하면 팀원들의 캐릭터가 폴짝 뜁니다.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayoung-99/tap-tap.git"
  },
  "homepage": "https://tap-tap-desktop.vercel.app",
  "main": "dist-main/main/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "vite build --config vite.config.mts && vite build --config vite.preload.config.mts && vite build --config vite.main.config.mts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "start": "npm run build && electron .",
    "start:second": "npm run build && TAPTAP_PROFILE=second electron .",
    "start:both": "npm run build && (trap 'kill 0' INT TERM EXIT; electron . & TAPTAP_PROFILE=second electron . & wait)",
    "dev": "vite build --config vite.config.mts --watch",
    "preview": "npm run build && electron scripts/preview.js",
    "tray-icon": "node scripts/make-tray-icon.js",
    "app-icon": "npm run build && electron scripts/make-app-icon.js",
    "site-images": "npm run build && electron scripts/make-site-images.js",
    "site": "node scripts/serve-site.js",
    "site:open": "node scripts/serve-site.js --open",
    "dist": "npm run build && node scripts/bake-config.js && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:site": "node scripts/check-site.js",
    "check": "npm run build && node scripts/e2e-check.js",
    "check:expiry": "npm run build && node scripts/check-expiry.js"
  },
  "build": {
    "appId": "com.taptap.desktop",
    "productName": "tap-tap",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-main/**/*",
      "dist-renderer/**/*",
      "!dist-renderer/preview/**",
      "!dist-renderer/icon/**",
      "!dist-renderer/site-assets/**",
      "dist-preload/**/*",
      "assets/**/*",
      "package.json",
      "config.generated.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "hayoung-99",
        "repo": "tap-tap",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.78.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
