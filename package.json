{
  "name": "tap-tap-workspace",
  "private": true,
  "description": "tap-tap 저장소. 실제 앱은 apps/ 아래에 있다.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayoung-99/tap-tap.git"
  },
  "homepage": "https://tap-tap-desktop.vercel.app",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w tap-tap",
    "test": "npm run test -w tap-tap",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "start": "npm run start -w tap-tap",
    "dev": "npm run dev -w tap-tap",
    "dist": "npm run dist -w tap-tap",
    "check": "npm run check -w tap-tap",
    "check:expiry": "npm run check:expiry -w tap-tap",
    "preview": "npm run preview -w tap-tap",
    "tray-icon": "npm run tray-icon -w tap-tap",
    "app-icon": "npm run app-icon -w tap-tap",
    "site-images": "npm run site-images -w tap-tap",
    "site": "node scripts/serve-site.js",
    "site:open": "node scripts/serve-site.js --open",
    "check:site": "node scripts/check-site.js"
  },
  "devDependencies": {
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
