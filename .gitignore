node_modules/
dist/
apps/*/dist/
# 렌더러·preload 빌드 산출물 (npm run build 로 언제든 다시 만든다)
apps/*/dist-renderer/
apps/*/dist-preload/
.DS_Store
*.log

# 개발용 캡처 (TAPTAP_CAPTURE 로 언제든 다시 뜰 수 있다)
.preview/

# 접속 정보가 든 파일들. 경로를 가리지 않고 전부 막는다 —
# 도구가 실수로 다른 곳에 떨어뜨려도 커밋되지 않게 하기 위해서다.
.env
config.generated.json

# Vercel 이 남기는 로컬 연결 정보
.vercel/

# 아이콘 만들 때 잠깐 생기는 중간 폴더 (최종 icns·ico·png 는 커밋한다)
build/icon.iconset/

# Playwright MCP 가 남기는 스크린샷·스냅샷
.playwright-mcp/

# 브라우저로 읽는 플랜서(고치기 전)와 완료 보고서(고친 뒤). 읽고 나면 쓸모가 끝나는
# 문서라, 커밋하면 PR 디프에 HTML 덩어리만 섞여 정작 코드 리뷰를 방해한다.
.claude/plans/
.claude/reports/

# 메인 프로세스 빌드 산출물 (npm run build 로 언제든 다시 만든다)
apps/*/dist-main/
*.tsbuildinfo
apps/*/.next/

# 내부 문서는 저장소에 올리지 않고 로컬에서만 봅니다. 기획서·지침서·개발 안내는
# 만드는 쪽이 판단할 때 보는 것이지, 저장소를 찾아온 사람에게 보여 줄 것이 아닙니다.
# docs/ 를 통째로 막지 않는 이유는 두 파일이 실제로 읽히기 때문입니다 —
# release.yml 이 docs/release-notes.md 로 릴리스 노트를 만들고, 앱이 접속 정보가
# 없을 때 사용자에게 docs/SUPABASE_SETUP.md 를 보라고 안내합니다.
CLAUDE.md
docs/PRODUCT.md
docs/RELEASE.md
docs/DEVELOPMENT.md

# 데이터베이스 스키마도 같은 이유로 올리지 않습니다. 저장소를 찾아온 사람이 읽을
# 것이 아니라 이 프로젝트를 굴리는 쪽이 Supabase 콘솔에 붙여넣는 파일입니다.
# docs/SUPABASE_SETUP.md 는 앱이 접속 정보가 없을 때 가리키는 곳이라 남겨 두므로,
# 그 문서에서 이 폴더를 링크하지 마세요 — GitHub 에서 404 가 됩니다.
supabase/
