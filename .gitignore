node_modules/
dist/
apps/*/dist/
# 렌더러·preload 빌드 산출물 (npm run build 로 언제든 다시 만든다)
apps/*/dist-renderer/
apps/*/dist-preload/
.DS_Store
*.log

# 개발용 캡처 (TAPTAP_CAPTURE 로 언제든 다시 뜰 수 있다)
.preview/

# 접속 정보가 든 파일들. 경로를 가리지 않고 전부 막는다 —
# 도구가 실수로 다른 곳에 떨어뜨려도 커밋되지 않게 하기 위해서다.
.env
config.generated.json

# Vercel 이 남기는 로컬 연결 정보
.vercel/

# 아이콘 만들 때 잠깐 생기는 중간 폴더 (최종 icns·ico·png 는 커밋한다)
build/icon.iconset/

# Playwright MCP 가 남기는 스크린샷·스냅샷
.playwright-mcp/

# 브라우저로 읽는 플랜서(고치기 전)와 완료 보고서(고친 뒤). 읽고 나면 쓸모가 끝나는
# 문서라, 커밋하면 PR 디프에 HTML 덩어리만 섞여 정작 코드 리뷰를 방해한다.
.claude/plans/
.claude/reports/

# 기획→기술설계→개발→코드리뷰 파이프라인을 돌리는 서브에이전트 정의와, 그걸 잇는
# /build-feature 명령. 브라우저 플랜서를 띄우는 render_doc.py 개인 경로(alice 상위
# 폴더)를 그대로 참조하므로, 다른 사람이나 다른 기기에서 받으면 존재하지 않는 경로를
# 부르게 된다. 이 저장소 밖의 개인 도구다. 이 파이프라인이 만드는 결과물
# (docs/PRODUCT.md · docs/DEVELOPMENT.md · docs/design/*.md)은 그대로 커밋된다.
.claude/agents/
.claude/commands/

# 메인 프로세스 빌드 산출물 (npm run build 로 언제든 다시 만든다)
apps/*/dist-main/
*.tsbuildinfo
apps/*/.next/

# 기획서·지침서·개발 안내·디자인 시스템은 **저장소에 함께 올립니다.**
#
# 한동안 로컬에만 두었습니다. "만드는 쪽이 판단할 때 보는 것이지 저장소를 찾아온
# 사람에게 보여 줄 것이 아니다" 라는 이유였는데, 실제로는 그 반대에 가까웠습니다 —
# 이 저장소를 찾아오는 사람은 대개 이 앱을 고치려는 사람(또는 에이전트)이고, 그
# 사람에게 가장 필요한 것이 바로 그 문서들입니다. 안 올리는 동안 저장소에 남는
# 문서에서 이 파일들을 링크할 수 없다는 제약도 계속 따라다녔습니다.
#
# 공개 전에 다섯 문서를 문장 단위로 훑었습니다. 키·토큰·주소·개인정보는 없었고,
# 어드민 RPC 이름처럼 민감해 보이는 것들은 이미 `apps/web/lib/admin.ts` 에 공개되어
# 있었습니다. 유일하게 걸린 것은 아직 막지 않은 남용 경로를 방법까지 적어 둔
# `docs/RELEASE.md` 3장이었고, 그건 사실과 대책만 남기고 방법을 걷어냈습니다.
#
# **새 문서를 더할 때도 그 검토를 먼저 합니다.** 특히 "아직 안 막았다" 는 문장은
# 공개 저장소에서 곧 안내가 됩니다.

# 다만 아래 둘은 계속 로컬에만 둡니다.
#
# supabase/ 는 저장소를 찾아온 사람이 읽을 것이 아니라 이 프로젝트를 굴리는 쪽이
# Supabase 콘솔에 붙여넣는 파일이고, **실제 방어(RPC 안의 검사)가 거기 있습니다.**
# docs/SUPABASE_SETUP.md 는 앱이 접속 정보가 없을 때 가리키는 곳이라 남겨 두므로,
# 그 문서에서 이 폴더를 링크하지 마세요 — GitHub 에서 404 가 됩니다.
#
# .impeccable/critique/ 는 문서가 아니라 **작업 기록**입니다. 어느 시점의 진단이라
# 금방 낡는데, 저장소에 쌓이면 어느 것이 지금 유효한지 흐려집니다. 같은 폴더의
# design.json 은 DESIGN.md 의 짝이므로 함께 올립니다.
apps/*/.impeccable/critique/

supabase/
